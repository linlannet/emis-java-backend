<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.emis.app.dao.AppPermissionActionDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.emis.app.entity.AppPermissionAction" id="appPermissionActionMap">
        <id property="id" column="ID"/>
        <result property="foreignId" column="FOREIGN_ID"/>
        <result property="content" column="CONTENT"/>
        <result property="type" column="TYPE"/>
        <result property="name" column="NAME"/>
        <result property="resourceId" column="RESOURCE_ID"/>
        <result property="creatorId" column="CREATOR_ID"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="lastTime" column="LAST_TIME"/>
        <result property="delFlag" column="DEL_FLAG"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="spare1" column="SPARE1"/>
        <result property="spare2" column="SPARE2"/>
    </resultMap>

    <!-- find by id，通过主键获取对象 -->
    <select id="findById" resultMap="appPermissionActionMap">
        SELECT
ID, FOREIGN_ID, CONTENT, TYPE, NAME, RESOURCE_ID, CREATOR_ID, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
        FROM EMIS_APP_PERMISSION_ACTION B
        WHERE B.ID = #{value}
    </select>

    <!-- get list，通过输入的条件，获取返回的list列表对象，采用相应的分页规则进行分页处理 -->
    <select id="getList" resultMap="appPermissionActionMap">
        SELECT
B.ID, B.FOREIGN_ID, B.CONTENT, B.TYPE, B.NAME, B.RESOURCE_ID, B.CREATOR_ID, B.CREATE_TIME, B.LAST_TIME, B.DEL_FLAG, B.DESCRIPTION, B.SPARE1, B.SPARE2
        FROM EMIS_APP_PERMISSION_ACTION B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>

    <!-- 通用排序SQL，如果传入参数按照参数排序，如果未传入参数，按照主键排序 -->
    <sql id="getListOrderBy">
        <choose>
            <when test='orderBy != null'>
                <choose>
                    <when test='orderBy == 0'>
                        ORDER BY B.CREATE_TIME DESC
                    </when>
                    <when test='orderBy == 1'>
                        ORDER BY B.CREATE_TIME ASC
                    </when>
                    <when test='orderBy == 2'>
                        ORDER BY B.PRIORITY DESC
                    </when>
                    <when test='orderBy == 3'>
                        ORDER BY B.PRIORITY ASC
                    </when>
                    <otherwise>
                        ORDER BY B.ID ASC
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                ORDER BY B.ID DESC
            </otherwise>
        </choose>
    </sql>

    <!-- sql commonList 通过输入的条件，获取返回的list列表对象 -->
    <sql id="commonList">
        <!--  只允许默认的本表的字段查询，查询条件可通过Param定义，默认全部字段，后续根据Param内的定义，可删除不需要的查询字段 -->
        <if test="id != null and id != ''">
            and B.ID = #{id}
        </if>
        <if test="foreignId != null and foreignId != ''">
            and B.FOREIGN_ID = #{foreignId}
        </if>
        <if test="content != null and content != ''">
            and B.CONTENT = #{content}
        </if>
        <if test="type != null and type != ''">
            and B.TYPE = #{type}
        </if>
        <if test="name != null and name != ''">
            and B.NAME = #{name}
        </if>
        <if test="resourceId != null and resourceId != ''">
            and B.RESOURCE_ID = #{resourceId}
        </if>
        <if test="creatorId != null and creatorId != ''">
            and B.CREATOR_ID = #{creatorId}
        </if>
        <choose>
            <when test="delFlag != null">
                AND B.DEL_FLAG = #{delFlag}
            </when>
            <otherwise>
                AND ( B.DEL_FLAG = 0 OR B.DEL_FLAG IS NULL)
            </otherwise>
        </choose>
        <if test="description != null and description != ''">
            and B.DESCRIPTION = #{description}
        </if>
        <if test="spare1 != null and spare1 != ''">
            and B.SPARE1 = #{spare1}
        </if>
        <if test="spare2 != null and spare2 != ''">
            and B.SPARE2 = #{spare2}
        </if>

        <!-- 各个数据库差异化的查询条件处理，如时间字段 -->
        <choose>
            <when test='_databaseId == "mysql"'>

            </when>
            <when test='_databaseId == "dm8"'>

            </when>
            <otherwise>

            </otherwise>
        </choose>

    </sql>

    <!-- save object，保存对象信息 -->
    <insert id="save" parameterType="net.linlan.emis.app.entity.AppPermissionAction">
        INSERT INTO EMIS_APP_PERMISSION_ACTION
        (
ID, FOREIGN_ID, CONTENT, TYPE, NAME, RESOURCE_ID, CREATOR_ID, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
        )
        VALUES
        (
#{id}, #{foreignId}, #{content}, #{type}, #{name}, #{resourceId}, #{creatorId}, #{createTime}, #{lastTime}, #{delFlag}, #{description}, #{spare1}, #{spare2}
        )
    </insert>

    <insert id="batchSave" parameterType="java.util.List">
        <choose>
            <when test='_databaseId == "mysql"'>
                INSERT INTO EMIS_APP_PERMISSION_ACTION
                (
ID, FOREIGN_ID, CONTENT, TYPE, NAME, RESOURCE_ID, CREATOR_ID, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
                )
                VALUES
                <foreach collection="list" index="index" item="item" separator=",">
                    (
#{item.id}, #{item.foreignId}, #{item.content}, #{item.type}, #{item.name}, #{item.resourceId}, #{item.creatorId}, #{item.createTime}, #{item.lastTime}, #{item.delFlag}, #{item.description}, #{item.spare1}, #{item.spare2}
                    )
                </foreach>
            </when>
            <otherwise>
                <foreach collection="list" item="item" index="index" open="begin" close=";end;" separator=";">
                    INSERT INTO EMIS_APP_PERMISSION_ACTION
                    (
ID, FOREIGN_ID, CONTENT, TYPE, NAME, RESOURCE_ID, CREATOR_ID, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
                    )
                    VALUES
                    (
#{item.id}, #{item.foreignId}, #{item.content}, #{item.type}, #{item.name}, #{item.resourceId}, #{item.creatorId}, #{item.createTime}, #{item.lastTime}, #{item.delFlag}, #{item.description}, #{item.spare1}, #{item.spare2}
                    )
                </foreach>
            </otherwise>
        </choose>
    </insert>

    <!-- update object，更新对象信息 -->
    <update id="update" parameterType="net.linlan.emis.app.entity.AppPermissionAction">
        UPDATE EMIS_APP_PERMISSION_ACTION
        <set>
            <if test="foreignId != null">FOREIGN_ID = #{foreignId}, </if>
            <if test="content != null">CONTENT = #{content}, </if>
            <if test="type != null">TYPE = #{type}, </if>
            <if test="name != null">NAME = #{name}, </if>
            <if test="resourceId != null">RESOURCE_ID = #{resourceId}, </if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId}, </if>
            <if test="createTime != null">CREATE_TIME = #{createTime}, </if>
            <if test="lastTime != null">LAST_TIME = #{lastTime}, </if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag}, </if>
            <if test="description != null">DESCRIPTION = #{description}, </if>
            <if test="spare1 != null">SPARE1 = #{spare1}, </if>
            <if test="spare2 != null">SPARE2 = #{spare2}</if>
        </set>
        WHERE ID = #{id}
    </update>

    <!-- delete by id，通过主键删除对象 -->
    <delete id="deleteById">
        DELETE FROM EMIS_APP_PERMISSION_ACTION
        WHERE ID = #{value}
    </delete>

    <!-- delete by ids，通过主键数组批量删除对象 -->
    <delete id="deleteByIds">
        DELETE FROM EMIS_APP_PERMISSION_ACTION
        WHERE ID IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- query total，通过输入的条件，查询返回结果的数量，返回值为int -->
    <select id="getCount" resultType="int">
        SELECT COUNT(1)
        FROM EMIS_APP_PERMISSION_ACTION B
        WHERE 1 = 1
        <include refid="commonList"></include>
    </select>

    <!-- get list with dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <resultMap type="net.linlan.emis.app.dto.AppPermissionActionDto" extends="appPermissionActionMap" id="appPermissionActionDtoMap">

    </resultMap>

    <!-- get page with param input dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <select id="getPageDto" resultMap="appPermissionActionDtoMap">
        SELECT
B.ID, B.FOREIGN_ID, B.CONTENT, B.TYPE, B.NAME, B.RESOURCE_ID, B.CREATOR_ID, B.CREATE_TIME, B.LAST_TIME, B.DEL_FLAG, B.DESCRIPTION, B.SPARE1, B.SPARE2
        FROM EMIS_APP_PERMISSION_ACTION B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>

    </select>

    <!-- get dto with input id，通过ID，查询dto对象 -->
    <select id="getDtoById" resultMap="appPermissionActionDtoMap">
        SELECT
B.ID, B.FOREIGN_ID, B.CONTENT, B.TYPE, B.NAME, B.RESOURCE_ID, B.CREATOR_ID, B.CREATE_TIME, B.LAST_TIME, B.DEL_FLAG, B.DESCRIPTION, B.SPARE1, B.SPARE2
        FROM EMIS_APP_PERMISSION_ACTION B
        WHERE ID = #{value}
    </select>

    <!-- 以下为新增特定的操作 -->


</mapper>
