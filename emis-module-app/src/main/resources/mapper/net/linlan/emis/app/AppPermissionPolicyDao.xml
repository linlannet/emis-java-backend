<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.linlan.emis.app.dao.AppPermissionPolicyDao">

    <!-- 采用别名使用类成员变量，可根据需求，确定是否启用 -->
    <resultMap type="net.linlan.emis.app.entity.AppPermissionPolicy" id="appPermissionPolicyMap">
        <id property="id" column="ID"/>
        <result property="appId" column="APP_ID"/>
        <result property="foreignId" column="FOREIGN_ID"/>
        <result property="subjectId" column="SUBJECT_ID"/>
        <result property="subjectType" column="SUBJECT_TYPE"/>
        <result property="objectId" column="OBJECT_ID"/>
        <result property="objectType" column="OBJECT_TYPE"/>
        <result property="effect" column="EFFECT"/>
        <result property="creatorId" column="CREATOR_ID"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="lastTime" column="LAST_TIME"/>
        <result property="delFlag" column="DEL_FLAG"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="spare1" column="SPARE1"/>
        <result property="spare2" column="SPARE2"/>
    </resultMap>

    <!-- find by id，通过主键获取对象 -->
    <select id="findById" resultMap="appPermissionPolicyMap">
        SELECT
ID, APP_ID, FOREIGN_ID, SUBJECT_ID, SUBJECT_TYPE, OBJECT_ID, OBJECT_TYPE, EFFECT, CREATOR_ID, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
        FROM EMIS_APP_PERMISSION_POLICY B
        WHERE B.ID = #{value}
    </select>

    <!-- get list，通过输入的条件，获取返回的list列表对象，采用相应的分页规则进行分页处理 -->
    <select id="getList" resultMap="appPermissionPolicyMap">
        SELECT
B.ID, B.APP_ID, B.FOREIGN_ID, B.SUBJECT_ID, B.SUBJECT_TYPE, B.OBJECT_ID, B.OBJECT_TYPE, B.EFFECT, B.CREATOR_ID, B.CREATE_TIME, B.LAST_TIME, B.DEL_FLAG, B.DESCRIPTION, B.SPARE1, B.SPARE2
        FROM EMIS_APP_PERMISSION_POLICY B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>
    </select>

    <!-- 通用排序SQL，如果传入参数按照参数排序，如果未传入参数，按照主键排序 -->
    <sql id="getListOrderBy">
        <choose>
            <when test='orderBy != null'>
                <choose>
                    <when test='orderBy == 0'>
                        ORDER BY B.CREATE_TIME DESC
                    </when>
                    <when test='orderBy == 1'>
                        ORDER BY B.CREATE_TIME ASC
                    </when>
                    <when test='orderBy == 2'>
                        ORDER BY B.PRIORITY DESC
                    </when>
                    <when test='orderBy == 3'>
                        ORDER BY B.PRIORITY ASC
                    </when>
                    <otherwise>
                        ORDER BY B.ID ASC
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                ORDER BY B.ID DESC
            </otherwise>
        </choose>
    </sql>

    <!-- sql commonList 通过输入的条件，获取返回的list列表对象 -->
    <sql id="commonList">
        <!--  只允许默认的本表的字段查询，查询条件可通过Param定义，默认全部字段，后续根据Param内的定义，可删除不需要的查询字段 -->
        <if test="id != null and id != ''">
            and B.ID = #{id}
        </if>
        <if test="appId != null and appId != ''">
            and B.APP_ID = #{appId}
        </if>
        <if test="foreignId != null and foreignId != ''">
            and B.FOREIGN_ID = #{foreignId}
        </if>
        <if test="subjectId != null and subjectId != ''">
            and B.SUBJECT_ID = #{subjectId}
        </if>
        <if test="subjectType != null and subjectType != ''">
            and B.SUBJECT_TYPE = #{subjectType}
        </if>
        <if test="objectId != null and objectId != ''">
            and B.OBJECT_ID = #{objectId}
        </if>
        <if test="objectType != null and objectType != ''">
            and B.OBJECT_TYPE = #{objectType}
        </if>
        <if test="effect != null and effect != ''">
            and B.EFFECT = #{effect}
        </if>
        <if test="creatorId != null and creatorId != ''">
            and B.CREATOR_ID = #{creatorId}
        </if>
        <choose>
            <when test="delFlag != null">
                AND B.DEL_FLAG = #{delFlag}
            </when>
            <otherwise>
                AND ( B.DEL_FLAG = 0 OR B.DEL_FLAG IS NULL)
            </otherwise>
        </choose>
        <if test="description != null and description != ''">
            and B.DESCRIPTION = #{description}
        </if>
        <if test="spare1 != null and spare1 != ''">
            and B.SPARE1 = #{spare1}
        </if>
        <if test="spare2 != null and spare2 != ''">
            and B.SPARE2 = #{spare2}
        </if>

        <!-- 各个数据库差异化的查询条件处理，如时间字段 -->
        <choose>
            <when test='_databaseId == "mysql"'>

            </when>
            <when test='_databaseId == "dm8"'>

            </when>
            <otherwise>

            </otherwise>
        </choose>

    </sql>

    <!-- save object，保存对象信息 -->
    <insert id="save" parameterType="net.linlan.emis.app.entity.AppPermissionPolicy">
        INSERT INTO EMIS_APP_PERMISSION_POLICY
        (
ID, APP_ID, FOREIGN_ID, SUBJECT_ID, SUBJECT_TYPE, OBJECT_ID, OBJECT_TYPE, EFFECT, CREATOR_ID, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
        )
        VALUES
        (
#{id}, #{appId}, #{foreignId}, #{subjectId}, #{subjectType}, #{objectId}, #{objectType}, #{effect}, #{creatorId}, #{createTime}, #{lastTime}, #{delFlag}, #{description}, #{spare1}, #{spare2}
        )
    </insert>

    <insert id="batchSave" parameterType="java.util.List">
        <choose>
            <when test='_databaseId == "mysql"'>
                INSERT INTO EMIS_APP_PERMISSION_POLICY
                (
ID, APP_ID, FOREIGN_ID, SUBJECT_ID, SUBJECT_TYPE, OBJECT_ID, OBJECT_TYPE, EFFECT, CREATOR_ID, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
                )
                VALUES
                <foreach collection="list" index="index" item="item" separator=",">
                    (
#{item.id}, #{item.appId}, #{item.foreignId}, #{item.subjectId}, #{item.subjectType}, #{item.objectId}, #{item.objectType}, #{item.effect}, #{item.creatorId}, #{item.createTime}, #{item.lastTime}, #{item.delFlag}, #{item.description}, #{item.spare1}, #{item.spare2}
                    )
                </foreach>
            </when>
            <otherwise>
                <foreach collection="list" item="item" index="index" open="begin" close=";end;" separator=";">
                    INSERT INTO EMIS_APP_PERMISSION_POLICY
                    (
ID, APP_ID, FOREIGN_ID, SUBJECT_ID, SUBJECT_TYPE, OBJECT_ID, OBJECT_TYPE, EFFECT, CREATOR_ID, CREATE_TIME, LAST_TIME, DEL_FLAG, DESCRIPTION, SPARE1, SPARE2
                    )
                    VALUES
                    (
#{item.id}, #{item.appId}, #{item.foreignId}, #{item.subjectId}, #{item.subjectType}, #{item.objectId}, #{item.objectType}, #{item.effect}, #{item.creatorId}, #{item.createTime}, #{item.lastTime}, #{item.delFlag}, #{item.description}, #{item.spare1}, #{item.spare2}
                    )
                </foreach>
            </otherwise>
        </choose>
    </insert>

    <!-- update object，更新对象信息 -->
    <update id="update" parameterType="net.linlan.emis.app.entity.AppPermissionPolicy">
        UPDATE EMIS_APP_PERMISSION_POLICY
        <set>
            <if test="appId != null">APP_ID = #{appId}, </if>
            <if test="foreignId != null">FOREIGN_ID = #{foreignId}, </if>
            <if test="subjectId != null">SUBJECT_ID = #{subjectId}, </if>
            <if test="subjectType != null">SUBJECT_TYPE = #{subjectType}, </if>
            <if test="objectId != null">OBJECT_ID = #{objectId}, </if>
            <if test="objectType != null">OBJECT_TYPE = #{objectType}, </if>
            <if test="effect != null">EFFECT = #{effect}, </if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId}, </if>
            <if test="createTime != null">CREATE_TIME = #{createTime}, </if>
            <if test="lastTime != null">LAST_TIME = #{lastTime}, </if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag}, </if>
            <if test="description != null">DESCRIPTION = #{description}, </if>
            <if test="spare1 != null">SPARE1 = #{spare1}, </if>
            <if test="spare2 != null">SPARE2 = #{spare2}</if>
        </set>
        WHERE ID = #{id}
    </update>

    <!-- delete by id，通过主键删除对象 -->
    <delete id="deleteById">
        DELETE FROM EMIS_APP_PERMISSION_POLICY
        WHERE ID = #{value}
    </delete>

    <!-- delete by ids，通过主键数组批量删除对象 -->
    <delete id="deleteByIds">
        DELETE FROM EMIS_APP_PERMISSION_POLICY
        WHERE ID IN
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- query total，通过输入的条件，查询返回结果的数量，返回值为int -->
    <select id="getCount" resultType="int">
        SELECT COUNT(1)
        FROM EMIS_APP_PERMISSION_POLICY B
        WHERE 1 = 1
        <include refid="commonList"></include>
    </select>

    <!-- get list with dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <resultMap type="net.linlan.emis.app.dto.AppPermissionPolicyDto" extends="appPermissionPolicyMap" id="appPermissionPolicyDtoMap">

    </resultMap>

    <!-- get page with param input dto result，通过输入的条件，返回查询结果信息，返回值为dto对象 -->
    <select id="getPageDto" resultMap="appPermissionPolicyDtoMap">
        SELECT
B.ID, B.APP_ID, B.FOREIGN_ID, B.SUBJECT_ID, B.SUBJECT_TYPE, B.OBJECT_ID, B.OBJECT_TYPE, B.EFFECT, B.CREATOR_ID, B.CREATE_TIME, B.LAST_TIME, B.DEL_FLAG, B.DESCRIPTION, B.SPARE1, B.SPARE2
        FROM EMIS_APP_PERMISSION_POLICY B
        WHERE 1=1
        <include refid="commonList"></include>
        <include refid="getListOrderBy"></include>

    </select>

    <!-- get dto with input id，通过ID，查询dto对象 -->
    <select id="getDtoById" resultMap="appPermissionPolicyDtoMap">
        SELECT
B.ID, B.APP_ID, B.FOREIGN_ID, B.SUBJECT_ID, B.SUBJECT_TYPE, B.OBJECT_ID, B.OBJECT_TYPE, B.EFFECT, B.CREATOR_ID, B.CREATE_TIME, B.LAST_TIME, B.DEL_FLAG, B.DESCRIPTION, B.SPARE1, B.SPARE2
        FROM EMIS_APP_PERMISSION_POLICY B
        WHERE ID = #{value}
    </select>

    <!-- 以下为新增特定的操作 -->


</mapper>
